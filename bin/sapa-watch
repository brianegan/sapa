#!/usr/bin/env python3
"""sapa watch — the mechanical half of watching a stream's PR.

Watching a PR is two jobs. Detecting what changed is mechanical and identical
every time; deciding what to do about it is not. This helper owns only the
mechanical half: it polls the PR for the current branch and emits one structured
line per real change. The `sapa-watch` skill runs it (via the agent's Monitor)
and reasons about each emitted event.

This mirrors the `sapa section` precedent — the fiddly, must-be-right logic lives
in one tested helper the skills call, instead of each session re-improvising it.
The bug that motivated this: an improvised loop treated an empty-but-successful
`gh` response as a state change and emitted a spurious event. Here an empty or
failed fetch is guarded and never counts as a change.

Events (one per line, tab-separated; the first token is the type):

    ci-failed    <comma-joined failing check names>
    new-review   <id>  <author>  <state>  <self|other>
    new-comment  <id>  <author>  <self|other>
    base-behind
    base-conflicted
    merged
    closed

`new-review` / `new-comment` carry a trailing `self`/`other` marker: `self` when
the author is the authenticated gh user (the stream's own developer), `other`
when it is anyone else. The skill routes on it — a `self` comment is answered in
the coding-agent chat, never on GitHub; an `other` comment is answered on GitHub.
If the viewer login can't be resolved, the marker fails safe to `self` so an
unknown viewer never triggers a public reply to the developer's own comment.

`new-review` / `new-comment` are the set difference of the current ids against
the last-seen ids (dedup). A review still in `PENDING` state is skipped entirely
— not emitted and not recorded as seen — because it is the author's own
unsubmitted draft that keeps its id when submitted; recording it while pending
would dedup away the submitted review and strand it as pending. `ci-failed`,
`base-behind`, and `base-conflicted` are edge-triggered:
emitted when the PR transitions into that state, not on every poll while it
holds. `base-behind` fires when the base moved and the branch can rebase cleanly;
`base-conflicted` fires when the base merge now conflicts
(`mergeStateStatus: DIRTY`) — a distinct event because that case escalates rather
than auto-rebases. `merged` / `closed` are terminal: emitted once, then the loop
stops.

`--base-behind` controls how "behind" is detected:

    protection (default) — fire base-behind only on `mergeStateStatus: BEHIND`,
        which GitHub reports only when a "require branches up to date" protection
        rule is active.
    any — also fire base-behind when the base has genuinely moved ahead but no
        such rule is forcing BEHIND (the status stays CLEAN/UNSTABLE). Detected
        with GitHub's compare API (`behind_by > 0`), since mergeStateStatus can't
        see it. Only this mode makes the extra compare call, and only when the
        status is not already BEHIND (already behind) or DIRTY (escalates to
        base-conflicted instead). Every merge to the base then makes each open PR
        rebase and re-gate, so it is opt-in.

Last-seen state is persisted to a state file (default: `<git-dir>/sapa-watch.json`)
so a resumed session dedups against what a prior session already saw, rather than
replaying every existing comment. The very first poll with no state file has an
empty baseline, so it surfaces the PR's current actionable state (useful when
attaching to a PR that already has failing CI or unaddressed comments).

Usage:
    sapa watch                 # poll with back-off, emit changes, exit on merged/closed
    sapa watch --once          # a single poll: diff against the state file, print, exit
    sapa watch --state-file P  # use P for last-seen state (default: <git-dir>/sapa-watch.json)
    sapa watch --start DIR     # locate the git dir for the state file from DIR (default: $PWD)
    sapa watch --base-behind any  # also treat a genuinely-behind branch as behind
                                  # without an "up to date" protection rule (default: protection)

Loop tuning via env (seconds): SAPA_WATCH_INTERVAL (base, default 30),
SAPA_WATCH_MAX_INTERVAL (cap, default 300), SAPA_WATCH_BACKOFF (factor, default 2).
A poll that yields no change backs the interval off toward the cap; a poll that
yields a change resets it to the base.

`gh` is assumed installed and authenticated, as everywhere else in sapa.
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
import time

# gh's statusCheckRollup mixes two shapes: check runs carry a `conclusion`,
# legacy status contexts carry a `state`. Either of these values means failed.
FAILING_CONCLUSIONS = {"FAILURE", "TIMED_OUT", "CANCELLED", "ACTION_REQUIRED", "STARTUP_FAILURE"}
FAILING_STATES = {"FAILURE", "ERROR"}

# Only the fields diff() actually reads. `state` doubles as the fetch sanity
# check: a response without it is not a usable PR view, so fetch_pr skips it.
# baseRefName/headRefName feed the compare call `--base-behind any` uses.
PR_JSON_FIELDS = "state,mergeStateStatus,statusCheckRollup,reviews,comments,baseRefName,headRefName"


def default_state_file(start: str) -> str:
    """`<git-dir>/sapa-watch.json` so a resumed session dedups against prior polls."""
    try:
        git_dir = subprocess.run(
            ["git", "-C", start, "rev-parse", "--absolute-git-dir"],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, check=True,
        ).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        git_dir = start
    return os.path.join(git_dir, "sapa-watch.json")


def load_state(path: str) -> dict:
    try:
        with open(path, "r", encoding="utf-8") as f:
            data = json.load(f)
    except (OSError, ValueError):
        data = {}
    return {
        "reviews": list(data.get("reviews", [])),
        "comments": list(data.get("comments", [])),
        "ci_failing": bool(data.get("ci_failing", False)),
        "behind": bool(data.get("behind", False)),
        "conflicted": bool(data.get("conflicted", False)),
    }


def save_state(path: str, state: dict) -> None:
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(state, f)
    os.replace(tmp, path)


def fetch_pr() -> dict | None:
    """Return the parsed PR JSON, or None on a failed/empty/unusable fetch.

    None is the guard the whole helper hangs on: a cycle that can't get a clean
    read is skipped, never mistaken for a state change (the #42 bug). A parseable
    response with no `state` (e.g. an empty `{}`) is not a usable PR view either,
    so it is treated the same way rather than clobbering the baseline.
    """
    try:
        proc = subprocess.run(
            ["gh", "pr", "view", "--json", PR_JSON_FIELDS],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True,
        )
    except OSError:
        return None
    if proc.returncode != 0:
        return None
    out = (proc.stdout or "").strip()
    if not out:
        return None
    try:
        pr = json.loads(out)
    except ValueError:
        return None
    if not isinstance(pr, dict) or not pr.get("state"):
        return None
    return pr


def failing_checks(rollup: list | None) -> list:
    names = []
    for c in rollup or []:
        conclusion = (c.get("conclusion") or "").upper()
        state = (c.get("state") or "").upper()
        if conclusion in FAILING_CONCLUSIONS or state in FAILING_STATES:
            names.append(c.get("name") or c.get("context") or "check")
    return names


def author_of(node: dict) -> str:
    return (node.get("author") or {}).get("login") or "?"


_viewer_login: str | None = None


def viewer_login() -> str | None:
    """The authenticated gh login, resolved once and cached after the first success.

    Returns None when it can't be determined (gh unavailable, unauthenticated,
    or an empty response). Callers treat None as "unknown" and fail safe. Only a
    successful resolution is cached; a failed one is retried on the next call
    rather than pinned, so a transient `gh` blip during the long-running watch
    loop does not lock the whole session into fail-safe mode (the loop's PR fetch
    recovers per poll the same way).
    """
    global _viewer_login
    if _viewer_login is not None:
        return _viewer_login
    try:
        proc = subprocess.run(
            ["gh", "api", "user", "--jq", ".login"],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True,
        )
    except OSError:
        return None
    if proc.returncode == 0:
        _viewer_login = (proc.stdout or "").strip() or None
    return _viewer_login


def relation(node: dict, viewer: str | None) -> str:
    """`self` if the node's author is the authenticated viewer, else `other`.

    Fails safe to `self` when the viewer login is unknown: a wrong `self` keeps
    the response private in the chat and is recoverable, whereas a wrong `other`
    would post the exact public reply-to-yourself anti-pattern this guards.
    """
    if viewer is None:
        return "self"
    return "self" if author_of(node) == viewer else "other"


def compare_behind_by(base: str | None, head: str | None) -> int:
    """Commits `base` is ahead of `head`, via GitHub's compare API.

    `behind_by > 0` means the base has moved ahead of this branch. Used only in
    `--base-behind any` mode, where `mergeStateStatus` stays CLEAN because no
    "up to date" protection rule is forcing BEHIND. Returns 0 on any failure,
    empty, or non-integer body: a bad read is treated as "no behind signal" for
    this poll — never a false base-behind — and the next good poll re-detects.
    gh fills the {owner}/{repo} placeholders from the current repo.
    """
    if not base or not head:
        return 0
    try:
        proc = subprocess.run(
            ["gh", "api", f"repos/{{owner}}/{{repo}}/compare/{base}...{head}", "--jq", ".behind_by"],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True,
        )
    except OSError:
        return 0
    if proc.returncode != 0:
        return 0
    try:
        return int((proc.stdout or "").strip())
    except ValueError:
        return 0


def diff(pr: dict, prior: dict, viewer: str | None, base_behind: str = "protection") -> tuple:
    """Compare the fetched PR against the prior state.

    Returns (events, new_state, terminal). `terminal` is set on merged/closed,
    which the caller uses to stop the loop. `viewer` is the authenticated gh
    login, used to tag each new review/comment `self` or `other`.
    """
    state = (pr.get("state") or "").upper()

    if state == "MERGED":
        return [("merged",)], None, True
    if state == "CLOSED":
        return [("closed",)], None, True

    # A review still in PENDING state is the author's own unsubmitted draft
    # (GitHub hides pending reviews from everyone but their author). It is not an
    # actionable event, and — load-bearing — its id must not enter the seen-set:
    # the review keeps that same id once submitted, so recording it while pending
    # would dedup away the submitted review and strand it as "pending" forever.
    # Dropping pending reviews from both emission and the baseline lets the
    # submitted review read as new.
    reviews = [r for r in (pr.get("reviews") or []) if (r.get("state") or "").upper() != "PENDING"]
    review_ids = [str(r.get("id")) for r in reviews if r.get("id") is not None]
    comment_ids = [str(c.get("id")) for c in (pr.get("comments") or []) if c.get("id") is not None]
    failing = failing_checks(pr.get("statusCheckRollup"))
    ci_failing = bool(failing)
    status = (pr.get("mergeStateStatus") or "").upper()
    behind = status == "BEHIND"
    # DIRTY is unambiguously a merge conflict against the base. BLOCKED (required
    # reviews, failing required checks) is left out: those states are already
    # surfaced by ci-failed / review events, so folding them in would double-fire.
    conflicted = status == "DIRTY"
    # `any` mode: when the base has genuinely moved ahead but no "up to date"
    # protection rule is forcing BEHIND (the status stays CLEAN/UNSTABLE), the
    # compare API is the only signal. Skip the extra call when the status already
    # answers it — BEHIND is already behind, DIRTY escalates to base-conflicted
    # and must not also fire base-behind. Edge-triggering still rides the single
    # `behind` flag below, so `any` needs no new state.
    if base_behind == "any" and not behind and not conflicted:
        behind = compare_behind_by(pr.get("baseRefName"), pr.get("headRefName")) > 0

    seen_reviews = set(prior["reviews"])
    seen_comments = set(prior["comments"])

    events = []
    if ci_failing and not prior["ci_failing"]:
        events.append(("ci-failed", ",".join(failing)))
    if behind and not prior["behind"]:
        events.append(("base-behind",))
    if conflicted and not prior["conflicted"]:
        events.append(("base-conflicted",))
    for r in reviews:
        rid = str(r.get("id"))
        if r.get("id") is not None and rid not in seen_reviews:
            events.append(("new-review", rid, author_of(r), (r.get("state") or "").upper(), relation(r, viewer)))
    for c in pr.get("comments") or []:
        cid = str(c.get("id"))
        if c.get("id") is not None and cid not in seen_comments:
            events.append(("new-comment", cid, author_of(c), relation(c, viewer)))

    new_state = {
        "reviews": review_ids,
        "comments": comment_ids,
        "ci_failing": ci_failing,
        "behind": behind,
        "conflicted": conflicted,
    }
    return events, new_state, False


def emit(events: list) -> None:
    for e in events:
        sys.stdout.write("\t".join(e) + "\n")
    sys.stdout.flush()


def poll_once(state_file: str, base_behind: str = "protection") -> tuple:
    """One poll. Returns (terminal, changed).

    A skipped cycle (failed/empty fetch) emits nothing and leaves the state file
    untouched, so the next good poll still sees the same baseline.
    """
    pr = fetch_pr()
    if pr is None:
        sys.stderr.write("sapa watch: skipped poll (empty or failed fetch)\n")
        return False, False  # (terminal, changed)
    prior = load_state(state_file)
    events, new_state, terminal = diff(pr, prior, viewer_login(), base_behind)
    emit(events)
    if not terminal:
        save_state(state_file, new_state)
    return terminal, bool(events)


def watch_loop(state_file: str, base_behind: str = "protection") -> int:
    base = float(os.environ.get("SAPA_WATCH_INTERVAL", "30"))
    cap = float(os.environ.get("SAPA_WATCH_MAX_INTERVAL", "300"))
    factor = float(os.environ.get("SAPA_WATCH_BACKOFF", "2"))
    interval = base
    while True:
        terminal, changed = poll_once(state_file, base_behind)
        if terminal:
            return 0
        interval = base if changed else min(cap, max(base, interval) * factor)
        if interval > 0:
            time.sleep(interval)


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="sapa watch",
        add_help=True,
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--once", action="store_true", help="single poll, then exit")
    parser.add_argument("--state-file")
    parser.add_argument("--start", default=os.environ.get("PWD") or os.getcwd())
    parser.add_argument(
        "--base-behind", choices=("protection", "any"), default="protection",
        help="how to detect a behind branch: protection (only mergeStateStatus BEHIND) "
             "or any (also the compare API's behind_by, no protection rule needed)",
    )
    args = parser.parse_args()

    state_file = args.state_file or default_state_file(args.start)

    if args.once:
        poll_once(state_file, args.base_behind)
        return 0

    sys.stderr.write("sapa watch: watching PR for the current branch\n")
    return watch_loop(state_file, args.base_behind)


if __name__ == "__main__":
    sys.exit(main())
