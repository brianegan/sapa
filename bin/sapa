#!/bin/bash
# sapa — one command for the whole stream toolkit.
#
# A thin dispatcher: `sapa <command> [args]` runs the matching helper. Only this
# script goes on your PATH (sapa install links it); it resolves its own location
# back through that symlink to the clone and calls the sibling helpers in bin/ by
# path, so they never need to be on PATH themselves.
#
# Usage:
#   sapa <command> [args]      # run a command
#   sapa help | -h | --help    # this help
#   sapa <command> --help      # help for one command
#
# Commands:
#   bootstrap   clone or init a repo into the .bare worktree layout
#   worktree    spin up a per-branch worktree off origin/main and open it
#   start       turn a GitHub or Jira issue into a worktree, ready to plan
#   issue       derive the issue identity and record/read the plan comment
#   config      locate (or print) the .sapa.yaml, or `config init` to create one
#   settings    locate (or print) your personal ~/.sapa/settings.yaml
#   tmp         print a per-stream scratch directory for the phase skills
#   section     maintain a machine-managed section of a PR body
#   status      record the current stream's status for the window switcher
#   gate        run the configured gate steps and emit one line per result
#   skills      provision and verify the skills your .sapa.yaml references
#   watch       poll the current branch's PR and emit one line per change
#   teardown    remove a merged stream's worktree and local branch
#   close       close a finished stream's editor window (a closer for teardown)
#   install     link sapa onto PATH and its skills into your agents
#   update      git pull the installed clone and reinstall
#   uninstall   remove the symlinks sapa install created
#   completion  print a shell completion script (e.g. eval "$(sapa completion zsh)")

set -euo pipefail

commands="bootstrap worktree start issue config settings tmp section status gate skills watch teardown close install update uninstall completion"

usage() { grep '^#' "$0" | grep -v '^#!' | sed 's/^# \{0,1\}//'; }

cmd="${1:-}"
case "$cmd" in
  "")          usage >&2; exit 2 ;;
  -h|--help|help) usage; exit 0 ;;
esac

# Confine dispatch to the known commands so a typo can't reach some other
# bin/sapa-* file (or a name we never meant to expose).
found=false
for c in $commands; do
  [ "$c" = "$cmd" ] && found=true && break
done
if ! $found; then
  echo "sapa: unknown command: $cmd" >&2
  echo "commands: $commands" >&2
  echo "run 'sapa help' for usage" >&2
  exit 2
fi

# Resolve this script through its symlink chain to find the clone's bin/, where
# the helpers live as siblings. A portable readlink loop — readlink -f is not
# reliable on macOS's BSD tools — handling absolute and relative link targets.
# A twin of this loop lives in bin/sapa-install (which resolves to the repo root
# instead); keep the two in sync. They can't share a sourced helper without a
# bootstrapping problem, since sapa install must run pre-PATH from a fresh clone.
self="$0"
hops=0
while [ -L "$self" ]; do
  hops=$((hops+1))
  if [ "$hops" -gt 40 ]; then
    echo "sapa: too many symlink hops resolving $0 (cycle?)" >&2
    exit 1
  fi
  link="$(readlink "$self")"
  case "$link" in
    /*) self="$link" ;;
    *)  self="$(dirname "$self")/$link" ;;
  esac
done
bindir="$(cd "$(dirname "$self")" && pwd)"

shift
exec "$bindir/sapa-$cmd" "$@"
