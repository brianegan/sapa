#!/usr/bin/env python3
"""sapa status — record the current stream's status for the window switcher.

sapa runs one editor window per stream. This writes a tiny JSON file per stream
to a global registry so a switcher (Jump) can show, at a glance across windows,
which streams are running, at rest, or need me. It is the producer half of the
Jump integration (issue #51); Jump reads the registry and renders a badge.

Two orthogonal fields, each written by whoever knows it:

    state   busy | idle | needs-you    the run-state, written by Claude Code hooks
    stage   plan | build | gate | submit | watch   the lifecycle phase, by the skills

They are written independently and merged: `--state` never clobbers `stage` and
vice versa, so the frequent run-state hook and the once-per-phase skill call can
race without losing each other's field (atomic tmp + os.replace, as sapa-watch).

Registry layout (one file per stream, so each window only ever writes its own —
no cross-window contention, and teardown removes just that file):

    ${SAPA_STATUS_DIR:-~/.sapa/status}/<worktree-basename>.json

keyed by the worktree basename, which equals the branch and is the token an
editor puts in its window title — the join Jump matches windows on. Each file:

    { "branch": "<branch>", "stage": "<stage>", "state": "<state>",
      "updated": "<UTC ISO-8601>" }

`stage` is written by each phase skill at its start and read back with `--report`,
which prints it and writes nothing. That read is what lets `sapa-flow` re-enter a
stream at the phase it left off in rather than at the top, across a session that
no longer remembers where it was. So `stage` means "where this stream picks up",
not "the last phase that happened to run": a caller that changes the answer (the
flow, after handling an interruption that invalidated a green gate) writes the
stage it wants resumed instead of leaving the old one to be second-guessed at read
time.

Self-guarding: the run-state hooks fire in *every* Claude session, not just sapa
ones. This resolves the stream by walking up for a `.bare` project root (the sapa
worktree layout); outside a sapa stream it does nothing and exits 0, so the global
hooks are harmless everywhere else.

The `Notification` event is overloaded: Claude Code fires it both when the agent
pauses mid-turn to ask (a permission/approval prompt — genuine attention) and for
the ~60s idle nudge after a turn already ended (not attention). Mapping both to
`needs-you` flips a paused stream to "needs you" ~60s after you walk away. So the
Notification hook uses `--notification`, which discriminates before writing:
primarily on the prior run-state (busy => mid-work => needs-you; idle => nudge =>
leave it), with the payload message as a secondary check.

`needs-you` would otherwise be sticky: it is set when the agent pauses to ask, but
resolving that prompt by approving a permission or answering a tool-based question
does not fire `UserPromptSubmit`, so nothing writes `busy` and the stream stays
"needs you" while the agent actively works. The `PreToolUse` hook fixes this with
`--active`: the agent's next tool call clears a stale `needs-you`. Because
`PreToolUse` fires on *every* tool call, `--active` writes only when there is
something to clear — it downgrades `needs-you` to `busy` and otherwise no-ops (no
file write, no `git` fork), so an active build does not churn the file.

Usage:
    sapa status --state busy|idle|needs-you   # set the run-state
    sapa status --notification                 # Notification hook: write needs-you only if genuine
    sapa status --active                        # PreToolUse hook: clear a stale needs-you on resumed work
    sapa status --stage plan|build|gate|submit|watch   # set the lifecycle stage
    sapa status --report                       # print the recorded stage, write nothing
    sapa status --clear                        # remove this stream's file
    sapa status --start DIR                    # resolve the stream from DIR (default: $PWD)
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from datetime import datetime, timezone

STATES = ["busy", "idle", "needs-you"]
STAGES = ["plan", "build", "gate", "submit", "watch"]


def find_stream(start: str):
    """Resolve (worktree_path, basename) for the sapa stream containing `start`.

    Walks up for the `.bare` project root, then takes the path component directly
    below it as the stream's worktree. Returns (None, None) when `start` is not
    inside a sapa worktree — including when it is the project root itself.
    """
    d = os.path.abspath(start)
    project_root = None
    cur = d
    while True:
        if os.path.isdir(os.path.join(cur, ".bare")):
            project_root = cur
            break
        parent = os.path.dirname(cur)
        if parent == cur:
            return (None, None)
        cur = parent
    rel = os.path.relpath(d, project_root)
    if rel in (".", ""):
        return (None, None)
    first = rel.split(os.sep)[0]
    if first in ("", ".", ".."):
        return (None, None)
    return (os.path.join(project_root, first), first)


def registry_dir() -> str:
    return os.environ.get("SAPA_STATUS_DIR") or os.path.expanduser("~/.sapa/status")


def branch_of(worktree: str, fallback: str) -> str:
    try:
        out = subprocess.run(
            ["git", "-C", worktree, "branch", "--show-current"],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, check=True,
        ).stdout.strip()
        return out or fallback
    except (OSError, subprocess.CalledProcessError):
        return fallback


def load(path: str) -> dict:
    try:
        with open(path, "r", encoding="utf-8") as f:
            data = json.load(f)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def save(path: str, data: dict) -> None:
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(data, f)
    os.replace(tmp, path)


def now() -> str:
    return datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def notification_message() -> str:
    """Best-effort read of the Notification payload's `message` from stdin.

    Claude Code delivers hook input as a JSON object on stdin. We only need the
    `message` field, and only for a secondary check, so anything unexpected — no
    stdin (a manual invocation on a tty), empty input, non-JSON, no `message` —
    returns "" and lets the caller fall back to the run-state rule.
    """
    try:
        if sys.stdin.isatty():
            return ""
        raw = sys.stdin.read()
    except (OSError, ValueError):
        return ""
    if not raw.strip():
        return ""
    try:
        payload = json.loads(raw)
    except ValueError:
        return ""
    if isinstance(payload, dict):
        msg = payload.get("message")
        return msg if isinstance(msg, str) else ""
    return ""


def notification_is_attention(prior_state: str | None, message: str) -> bool:
    """Whether a Notification is genuine attention (needs-you) or just the nudge.

    Primary signal is the prior run-state; the message is a secondary belt.
    """
    msg = (message or "").lower()
    # The idle nudge is never attention, even against a stale "busy".
    if "waiting for your input" in msg:
        return False
    # A permission/approval prompt is always attention.
    if "permission" in msg:
        return True
    # Otherwise fall back to the turn state: a Notification while busy is the
    # agent pausing mid-work to ask; after Stop (idle) it is just noise.
    return prior_state == "busy"


def main(argv: list[str]) -> int:
    p = argparse.ArgumentParser(
        prog="sapa status", add_help=True, description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument("--state", choices=STATES)
    p.add_argument("--notification", action="store_true")
    p.add_argument("--active", action="store_true")
    p.add_argument("--stage", choices=STAGES)
    p.add_argument("--report", action="store_true")
    p.add_argument("--clear", action="store_true")
    p.add_argument("--start", default=os.environ.get("PWD") or os.getcwd())
    args = p.parse_args(argv)

    writes = (args.state or args.notification or args.active or args.stage
              or args.clear)
    if not (writes or args.report):
        p.error("nothing to do: pass --state, --notification, --active, --stage, "
                "--report, or --clear")

    # --report reads and returns before any write path, so pairing it with one
    # would silently drop that write. Refuse instead of picking a winner.
    if args.report and writes:
        p.error("--report only reads: run it on its own, not with a write flag")

    # Read stdin before resolving the stream so a manual invocation on a tty is
    # guarded the same way regardless of location; harmless when unused.
    message = notification_message() if args.notification else ""

    worktree, basename = find_stream(args.start)
    if not basename:
        # Not a sapa stream (e.g. a hook firing in some other repo): do nothing.
        return 0

    path = os.path.join(registry_dir(), basename + ".json")

    if args.report:
        # The read half. Print the bare stage so a skill can use it directly in
        # shell without parsing JSON, as `sapa issue key` and `sapa tmp` do. A
        # stream with no file or no stage yet prints nothing and still exits 0:
        # "not started" is an ordinary answer here, not a failure, and the caller
        # reads it as "begin at the first phase".
        stage = load(path).get("stage")
        if stage:
            print(stage)
        return 0

    if args.notification:
        # The Notification hook fires for both real attention and the idle nudge.
        # Only write needs-you when it is genuine; otherwise leave the file be.
        data = load(path)
        if not notification_is_attention(data.get("state"), message):
            return 0
        data["branch"] = branch_of(worktree, basename)
        data["state"] = "needs-you"
        data["updated"] = now()
        try:
            save(path, data)
        except OSError as e:
            print(f"sapa status: could not write {path}: {e}", file=sys.stderr)
        return 0

    if args.active:
        # The PreToolUse hook fires on every tool call. Its only job is to clear a
        # stale needs-you the instant the agent resumes work (after you approve a
        # permission or answer a tool-based question, which never fires
        # UserPromptSubmit). Downgrade needs-you to busy; otherwise no-op — no
        # write and no git fork — so an active build does not churn the file.
        data = load(path)
        if data.get("state") != "needs-you":
            return 0
        data["branch"] = branch_of(worktree, basename)
        data["state"] = "busy"
        data["updated"] = now()
        try:
            save(path, data)
        except OSError as e:
            print(f"sapa status: could not write {path}: {e}", file=sys.stderr)
        return 0

    if args.clear:
        try:
            os.remove(path)
        except FileNotFoundError:
            pass
        except OSError as e:
            print(f"sapa status: could not remove {path}: {e}", file=sys.stderr)
        return 0

    data = load(path)
    data["branch"] = branch_of(worktree, basename)
    if args.state:
        data["state"] = args.state
    if args.stage:
        data["stage"] = args.stage
    data["updated"] = now()
    try:
        save(path, data)
    except OSError as e:
        # Never fail the caller (a hook must not break the session) — warn and move on.
        print(f"sapa status: could not write {path}: {e}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
