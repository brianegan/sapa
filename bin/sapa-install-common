#!/bin/bash
# sapa install/uninstall — shared bits. Sourced by both sapa-install and
# sapa-uninstall (never run directly, never linked, not a dispatcher command) so
# the link inventory and the removal helper live in one place and can't drift
# between the two commands. Callers have already set `set -euo pipefail`.

# What sapa puts on PATH: just the `sapa` dispatcher. LEGACY_BINS is the old
# one-per-command layout — never linked anymore, but swept on both install and
# uninstall so upgrading from that layout leaves nothing stale behind. SKILLS go
# into each agent's skills directory.
BINS="sapa"
LEGACY_BINS="sapa-bootstrap sapa-worktree sapa-start sapa-config sapa-section sapa-teardown sapa-install"
SKILLS="sapa-plan sapa-build sapa-gate sapa-submit sapa-watch sapa-flow"

bin_dir="${SAPA_BIN_DIR:-$HOME/.local/bin}"

# The agents to target: an explicit SAPA_AGENTS list (commas allowed), otherwise
# every known agent whose home directory exists.
agents=""
if [ -n "${SAPA_AGENTS:-}" ]; then
  agents="$(printf '%s' "$SAPA_AGENTS" | tr ',' ' ')"
else
  for a in claude codex; do
    [ -d "$HOME/.$a" ] && agents="$agents $a"
  done
fi

# remove_link removes an entry only when it is a symlink whose target looks like
# one of ours (matches the given glob), so a regular file or a link pointing
# elsewhere is never touched. It tallies into the caller's `removed`/`skipped`.
# Shared by the install-time legacy sweep and by uninstall.
removed=0
skipped=0
remove_link() {
  # $1 = path to the link, $2 = glob the target must match to be ours.
  local link="$1" want="$2"
  [ -L "$link" ] || return 0
  local target; target="$(readlink "$link")"
  case "$target" in
    $want) rm -f "$link"; removed=$((removed+1)) ;;
    *) skipped=$((skipped+1)) ;;
  esac
}

# manage_hooks add|remove — wire (or unwire) the run-state hooks that let the
# window switcher (Jump) show whether each stream is running, at rest, or waiting.
# They map Claude Code events to `sapa status`: UserPromptSubmit→busy, Stop→idle,
# Notification→`--notification` (which discriminates a real prompt from the ~60s
# idle nudge instead of blindly writing needs-you), and PreToolUse→`--active`
# (which clears a stale needs-you the instant the agent resumes work, and no-ops
# otherwise so it doesn't churn the file on every tool call). `sapa status`
# self-guards, so these are inert in any non-sapa session. Shared by sapa-install
# (add) and sapa-uninstall (remove) so the wiring and unwiring can't drift.
#
# This is the one place sapa edits a config file rather than printing a hint (the
# PATH/completion hints stay hints). It is made safe the way remove_link is: it
# only ever touches entries whose command is ours (matches `sapa status --state`
# or `--notification`), leaving every other hook the user has untouched. Idempotent
# on add (re-adds a clean copy, so a moved clone self-heals), exact on remove.
# python3 does the JSON surgery; if it is missing, or the settings file can't be
# read or written, we skip the hooks rather than fail the caller.
manage_hooks() {
  local action="$1" settings="$2" sapa_abs="$3"
  if ! command -v python3 >/dev/null 2>&1; then
    echo "sapa: python3 not found; skipped run-state status hooks" >&2
    return 0
  fi
  python3 - "$action" "$settings" "$sapa_abs" <<'PY'
import json, os, sys

action, settings, sapa_abs = sys.argv[1], sys.argv[2], sys.argv[3]
# Event -> the `sapa status` invocation wired for it. UserPromptSubmit/Stop record
# a fixed state; Notification discriminates the idle nudge from a real prompt, and
# PreToolUse clears a stale needs-you on resumed work, so each gets its own action
# rather than a fixed --state.
EVENTS = {
    "UserPromptSubmit": "status --state busy",
    "Notification": "status --notification",
    "PreToolUse": "status --active",
    "Stop": "status --state idle",
}
# The signatures that identify a hook command as ours. Every form is matched so a
# re-install migrates a pre-existing Notification --state needs-you hook (old form)
# to --notification (new form) rather than leaving a duplicate, and uninstall
# removes any of them.
MARKS = ("status --state", "status --notification", "status --active")

def is_ours(cmd):
    return isinstance(cmd, str) and "sapa" in cmd and any(m in cmd for m in MARKS)

existed = os.path.exists(settings)
if not existed and action == "remove":
    sys.exit(0)  # nothing to remove and never create a file just to prune it

data = {}
if existed:
    try:
        with open(settings) as f:
            loaded = json.load(f)
        if isinstance(loaded, dict):
            data = loaded
    except (OSError, ValueError) as e:
        # Unreadable or non-JSON (incl. a settings that is somehow a directory):
        # skip the hooks rather than proceed and risk clobbering, and rather than
        # abort the caller.
        print("sapa: could not read %s (%s); skipped status hooks" % (settings, e),
              file=sys.stderr)
        sys.exit(0)

hooks = data.get("hooks")
if not isinstance(hooks, dict):
    hooks = {}

def strip_ours(event):
    groups = hooks.get(event)
    if not isinstance(groups, list):
        return
    kept = []
    for g in groups:
        if isinstance(g, dict) and isinstance(g.get("hooks"), list):
            g["hooks"] = [h for h in g["hooks"]
                          if not (isinstance(h, dict) and is_ours(h.get("command")))]
            if g["hooks"]:
                kept.append(g)
        else:
            kept.append(g)
    if kept:
        hooks[event] = kept
    else:
        hooks.pop(event, None)

for event, invocation in EVENTS.items():
    strip_ours(event)  # remove any prior copy of ours first (idempotent add, exact remove)
    if action == "add":
        hooks.setdefault(event, []).append(
            {"hooks": [{"type": "command",
                        "command": "%s %s" % (sapa_abs, invocation)}]}
        )

if hooks:
    data["hooks"] = hooks
else:
    data.pop("hooks", None)

try:
    os.makedirs(os.path.dirname(settings) or ".", exist_ok=True)
    tmp = settings + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2)
        f.write("\n")
    os.replace(tmp, settings)
except OSError as e:
    # Honour the "skip the hooks rather than fail" promise: a write failure (e.g. a
    # read-only ~/.claude) must not abort the caller. Warn and move on.
    print("sapa: could not write %s: %s; skipped status hooks" % (settings, e),
          file=sys.stderr)
    sys.exit(0)
PY
}
