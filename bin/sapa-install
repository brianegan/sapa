#!/bin/bash
# sapa install — link the sapa command onto PATH and its skills into your agents.
#
# Symlinks the `sapa` dispatcher into a PATH directory and the skill/ directories
# into every coding agent that's installed (Claude Code, Codex — both read the
# same SKILL.md format). The other bin/sapa-* helpers are never linked: `sapa`
# resolves back to the clone and calls them by path. Links point into the clone
# you run this from, so a plain clone-and-run works; a sapa developer runs it from
# their `main` checkout so the links track merged code. Re-running is safe
# (idempotent), and it sweeps any links left by the old one-per-command layout.
#
# Removal is a separate command: `sapa uninstall`.
#
# Usage:
#   sapa install              # link sapa and skills
#
# (Run it as `bin/sapa install` from a fresh clone, before sapa is on PATH.)
#
# Environment:
#   SAPA_BIN_DIR   where sapa is linked (default ~/.local/bin).
#   SAPA_AGENTS    space/comma-separated agents to target (e.g. "claude codex").
#                  When unset, every agent whose ~/.<agent> directory exists is
#                  targeted.

set -euo pipefail

case "${1:-}" in
  -h|--help) grep '^#' "$0" | grep -v '^#!' | sed 's/^# \{0,1\}//'; exit 0 ;;
esac

case "${1:-}" in
  "") ;;
  uninstall) echo "sapa install: uninstall is now its own command; run 'sapa uninstall'" >&2
     exit 2 ;;
  *) echo "sapa install: unknown argument: $1" >&2
     echo "usage: sapa install" >&2
     exit 2 ;;
esac

# Source is the clone this script lives in: bin/sapa-install -> repo root.
# Resolve $0 through its symlink chain first, so re-running the linked copy on
# PATH (e.g. ~/.local/bin/sapa) still installs from the original clone rather
# than treating the PATH dir as the source. A portable readlink loop — readlink
# -f is not reliable on macOS's BSD tools — handling absolute and relative link
# targets. A twin of this loop lives in bin/sapa; keep the two in sync.
self="$0"
hops=0
while [ -L "$self" ]; do
  hops=$((hops+1))
  if [ "$hops" -gt 40 ]; then
    echo "sapa install: too many symlink hops resolving $0 (cycle?)" >&2
    exit 1
  fi
  link="$(readlink "$self")"
  case "$link" in
    /*) self="$link" ;;
    *)  self="$(dirname "$self")/$link" ;;
  esac
done
src_bindir="$(cd "$(dirname "$self")" && pwd)"
SRC="$(cd "$src_bindir/.." && pwd)"

# The link inventory (BINS/LEGACY_BINS/SKILLS), the target bin_dir, the agents to
# target, and remove_link — shared with sapa-uninstall so the two can't drift.
# (src_bindir is the clone we install *from*; bin_dir, set there, is where the
# links go — do not conflate the two.)
. "$src_bindir/sapa-install-common"

mkdir -p "$bin_dir"
for h in $BINS; do
  ln -sfn "$SRC/bin/$h" "$bin_dir/$h"
done
echo "sapa install: linked sapa into $bin_dir"

# Sweep leftover links from the old one-per-command layout so an upgrade in
# place doesn't leave stale sapa-* commands on PATH.
for h in $LEGACY_BINS; do
  remove_link "$bin_dir/$h" "*/bin/$h"
done
[ "$removed" -gt 0 ] && echo "sapa install: removed $removed legacy sapa-* link(s) from $bin_dir"

if [ -n "${agents// }" ]; then
  linked=""
  for a in $agents; do
    skills_dir="$HOME/.$a/skills"
    mkdir -p "$skills_dir"
    for s in $SKILLS; do
      ln -sfn "$SRC/skill/$s" "$skills_dir/$s"
    done
    linked="$linked $a"
  done
  echo "sapa install: linked skills into${linked}"
else
  echo "sapa install: no coding agents detected (~/.claude, ~/.codex); set SAPA_AGENTS to link skills anyway"
fi

# A PATH hint, not a failure — sapa is linked either way.
case ":$PATH:" in
  *":$bin_dir:"*) ;;
  *) echo "sapa install: note: $bin_dir is not on your PATH; add it, e.g. export PATH=\"$bin_dir:\$PATH\"" ;;
esac

# A completion hint, not a failure — we never edit your shell config, same as
# the PATH hint above. We print one line the user can copy, paste, and run to
# enable it themselves.
echo "sapa install: for zsh Tab-completion, run: echo 'eval \"\$(sapa completion zsh)\"' >> ~/.zshrc"
