#!/bin/bash
# sapa worktree — spin up a per-branch worktree off origin/main and open it.
#
# Walks up from the current directory to the project root (the parent of the
# `.bare` directory that sapa bootstrap creates), fetches origin, adds a worktree
# for the given branch, runs an optional per-project setup hook, and opens the
# tree in your editor.
#
# Usage:
#   sapa worktree <branch-name> [start-point]
#
# Opening is opt-in. Set `opener:` in your personal `~/.sapa/settings.yaml` to a
# command and it runs with the new worktree as its last argument:
#
#   opener: code -n
#
# Leave it unset and the worktree path is printed instead, for you to open how
# you like. The setting is personal rather than a project key on purpose: which
# editor you run is yours, not something a checked-in config should decide for
# the rest of the team. It is a sapa setting rather than $EDITOR because $EDITOR
# is one answer shared by every tool on the machine, and the program you want for
# a commit message is rarely the one you want a whole worktree opened in.

set -euo pipefail

case "${1:-}" in
  -h|--help) grep '^#' "$0" | grep -v '^#!' | sed 's/^# \{0,1\}//'; exit 0 ;;
esac

if [ -z "${1:-}" ]; then
  echo "sapa worktree: expected a branch name" >&2
  echo "usage: sapa worktree <branch-name> [start-point]" >&2
  exit 2
fi

input="$1"
start="${2:-}"

# Walk up from current directory until we find a .bare directory; its parent is the project root.
project_root=""
dir="${PWD:-$(pwd)}"
while [ -n "$dir" ] && [ "$dir" != "/" ]; do
  if [ -d "$dir/.bare" ]; then
    project_root="$dir"
    break
  fi
  dir=$(dirname "$dir")
done
if [ -z "$project_root" ]; then
  echo "sapa worktree: no .bare directory in any parent of the current directory" >&2
  exit 1
fi

# If the input looks like a remote ref (e.g. origin/my-feature), use the
# remote as the start point and the rest as the branch name.
if [ -z "$start" ] && [[ "$input" == */* ]]; then
  remote="${input%%/*}"
  if git -C "$project_root" remote | grep -qx "$remote"; then
    start="$input"
    branch="${input#*/}"
  else
    branch="$input"
  fi
else
  branch="$input"
fi

worktree_dir="$project_root/$branch"

git -C "$project_root" fetch origin

# Default to origin/main when no start point is given.
if [ -z "$start" ]; then
  start="origin/main"
fi

git -C "$project_root" worktree add "$worktree_dir" -b "$branch" "$start"

# Clean stale GIT_* env vars so tools that run git internally (e.g. FVM)
# don't get confused by the worktree context.
cd "$worktree_dir"
unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRS 2>/dev/null || true

# Run per-project setup if a .worktree-setup script exists at the project root.
if [ -x "$project_root/.worktree-setup" ]; then
  "$project_root/.worktree-setup"
fi

# Open the new worktree, if the personal settings say to. Unset means print the
# path instead, so sapa opens nothing you did not ask it to open.
#
# Resolve sapa-settings: prefer PATH, fall back to a sibling of this script, so
# the opener is found even when this is invoked by an absolute path with an empty
# PATH. A best-effort grep of the printed settings — no YAML parser — mirroring
# how the skills read their keys. Quotes are stripped so `opener: "code -n"`
# works too.
sapa_settings="$(command -v sapa-settings || true)"
if [ -z "$sapa_settings" ] && [ -x "$(dirname "$0")/sapa-settings" ]; then
  sapa_settings="$(dirname "$0")/sapa-settings"
fi
opener=""
if [ -n "$sapa_settings" ]; then
  opener="$("$sapa_settings" -p 2>/dev/null \
            | sed -nE 's/^[[:space:]]*opener:[[:space:]]*(.+)$/\1/p' \
            | head -1 \
            | sed -E 's/[[:space:]]+$//; s/^"(.*)"$/\1/; s/^'\''(.*)'\''$/\1/' || true)"
fi

# Unquoted on purpose: `opener: code -n` has to split into a command and its
# flags, the way a shell would read it. `set -f` first so that is all it does —
# splitting is the contract, and an opener value holding a `*` should reach the
# editor as a `*` rather than as whatever happens to sit in the current
# directory.
if [ -n "$opener" ]; then
  set -f
  exec $opener "$worktree_dir"
else
  echo "$worktree_dir"
fi
