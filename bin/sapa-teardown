#!/bin/bash
# sapa teardown — remove a finished stream's worktree and local branch.
#
# The terminal step of watch: once a PR is merged, the stream is done. This
# removes the worktree and deletes its local branch so there is no manual
# cleanup.
#
# Two guards:
#   * It refuses to tear down a worktree with uncommitted changes (exit 3).
#   * It runs `git` from the project root, never from inside the worktree it is
#     removing, so it works even when called from within that worktree. The
#     caller's shell cwd will be invalid afterwards — that is expected, the
#     window is closed for you.
#
# Closing the editor window: after removal it closes the VS Code window that was
# open on the worktree, so there is no manual window management. It finds the
# window by the worktree's basename (unique per stream) and presses that window's
# own close button — only when exactly one window matches, so it can never touch
# another window. Strictly best-effort — macOS + VS Code only, and it never fails
# the teardown. Disable it with `close_window: false` in `.sapa.yaml`. Set
# `SAPA_TEARDOWN_CLOSER` to a command that receives the basename to override how
# the close is performed (used by the tests).
#
# Pressing another app's button goes through System Events, which macOS gates
# behind Accessibility permission. If that permission is missing the close can't
# happen, so — rather than fail silently — teardown prints a one-line hint
# telling you to grant Accessibility to the app running this terminal (e.g.
# Visual Studio Code) in System Settings > Privacy & Security > Accessibility.
#
# Usage:
#   sapa teardown [worktree-path]   # defaults to the current directory
#   sapa teardown --force [path]    # remove even with uncommitted changes

set -euo pipefail

# Close the editor window open on the removed worktree. Best-effort: it never
# fails the teardown, which has already done its work by the time this runs. The
# close mechanism reports a status so the one failure worth surfacing — macOS
# denying Accessibility — becomes an actionable hint instead of silence. Status
# is one of: `closed`, `no-match` (zero or several windows matched), `no-editor`
# (VS Code not running), `error:<n>` (any failure, e.g. -25211 = no assistive
# access), or empty (the close killed osascript before it could report — that
# only happens on success, so treat it as `closed`).
#
# An override command (SAPA_TEARDOWN_CLOSER) takes the basename as $1 and emits
# the same status on stdout; otherwise we drive VS Code on macOS via System
# Events, pressing the close button of the one window whose title matches the
# basename — if zero or several match, we close nothing rather than risk the
# wrong window.
close_editor_window() {
  local name="$1"
  local result="" script=""
  if [ -n "${SAPA_TEARDOWN_CLOSER:-}" ]; then
    result="$("$SAPA_TEARDOWN_CLOSER" "$name" 2>/dev/null)" || true
  elif [ "$(uname -s)" = "Darwin" ] && command -v osascript >/dev/null 2>&1; then
    # Read the AppleScript into a variable with a plain heredoc, then feed it to
    # osascript via a here-string. A heredoc placed *inside* $(...) trips a
    # bash 3.2 (the macOS system bash) parser bug, so keep it out of the
    # command substitution.
    IFS= read -r -d '' script <<'APPLESCRIPT' || true
on run argv
  set targetName to item 1 of argv
  try
    tell application "System Events"
      if not (exists process "Code") then return "no-editor"
      tell process "Code"
        -- Resolve the match to a concrete window index before touching its
        -- close button. A compound reference like `first button of (item 1 of
        -- (every window whose name contains X)) whose subrole is Y` makes
        -- System Events mis-resolve the nested filter ("Invalid index") on any
        -- window that is not frontmost; indexing first is reliable.
        set idx to 0
        repeat with i from 1 to (count of windows)
          if (name of window i) contains targetName then
            if idx is 0 then
              set idx to i
            else
              return "no-match" -- several match; close nothing rather than guess
            end if
          end if
        end repeat
        if idx is 0 then return "no-match"
        perform action "AXPress" of ¬
          (first button of window idx whose subrole is "AXCloseButton")
        return "closed"
      end tell
    end tell
  on error e number n
    return "error:" & n
  end try
end run
APPLESCRIPT
    result="$(osascript - "$name" 2>&1 <<<"$script")" || true
  fi

  case "$result" in
    ""|closed|no-editor|no-match) : ;;  # done, or a benign no-op — stay quiet
    error:-25211|*"not allowed assistive access"*)
      printf '%s\n' "sapa teardown: couldn't close the editor window — grant Accessibility to the app running this terminal (e.g. Visual Studio Code) in System Settings > Privacy & Security > Accessibility, then it will close on the next teardown." >&2 ;;
    *)
      printf '%s\n' "sapa teardown: couldn't close the editor window ($result); left it open." >&2 ;;
  esac
}

force=false
target=""
while [ $# -gt 0 ]; do
  case "$1" in
    --force) force=true ;;
    -h|--help) grep '^#' "$0" | grep -v '^#!' | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) echo "sapa teardown: unknown flag: $1" >&2; exit 2 ;;
    *) target="$1" ;;
  esac
  shift
done

target="${target:-${PWD:-$(pwd)}}"
target="$(cd "$target" && pwd)"   # normalise to an absolute path

# Find the project root: walk up from the target until we see a .bare directory.
project_root=""
dir="$target"
while [ -n "$dir" ] && [ "$dir" != "/" ]; do
  if [ -d "$dir/.bare" ]; then project_root="$dir"; break; fi
  dir=$(dirname "$dir")
done
if [ -z "$project_root" ]; then
  echo "sapa teardown: no .bare found above $target" >&2
  exit 1
fi

if [ "$target" = "$project_root" ]; then
  echo "sapa teardown: refusing to remove the project root itself" >&2
  exit 1
fi

branch="$(git -C "$target" rev-parse --abbrev-ref HEAD)"

# Decide now, while the worktree (and its .sapa.yaml) still exists, whether to
# close the editor window afterwards. Absent or truthy `close_window` = close.
window_name="$(basename "$target")"
close_enabled=true
# Resolve sapa-config: prefer PATH, fall back to a sibling of this script, so the
# opt-out is honoured even when teardown is invoked by an absolute path with an
# empty PATH.
sapa_config="$(command -v sapa-config || true)"
if [ -z "$sapa_config" ] && [ -x "$(dirname "$0")/sapa-config" ]; then
  sapa_config="$(dirname "$0")/sapa-config"
fi
if [ -n "$sapa_config" ]; then
  cfg_val="$("$sapa_config" -p --start "$target" 2>/dev/null \
             | sed -nE 's/^[[:space:]]*close_window:[[:space:]]*([^#[:space:]]+).*$/\1/p' \
             | head -1 \
             | tr '[:upper:]' '[:lower:]' || true)"
  case "$cfg_val" in
    false|no|off|0) close_enabled=false ;;
  esac
fi

# Guard: never destroy uncommitted work.
if ! $force && [ -n "$(git -C "$target" status --porcelain)" ]; then
  echo "sapa teardown: $target has uncommitted changes; not removing." >&2
  echo "Commit, stash, or rerun with --force." >&2
  exit 3
fi

# Clear this stream's window-switcher status file while the worktree (and its
# `.bare` ancestor that `sapa status` walks up to) still exists, so the switcher
# stops showing a stream that is about to be gone. Best-effort — a missing helper
# or a failure here never blocks the teardown. Only the `sapa` dispatcher is on
# PATH, so call the helper by its sibling path, as the dispatcher itself does.
status_bin="$(dirname "$0")/sapa-status"
if [ -x "$status_bin" ]; then
  "$status_bin" --clear --start "$target" >/dev/null 2>&1 || true
fi

# Run git from the project root so the removal works even if the caller is
# sitting inside the worktree being removed.
if $force; then
  git -C "$project_root" worktree remove --force "$target"
else
  git -C "$project_root" worktree remove "$target"
fi

if [ -n "$branch" ] && [ "$branch" != "HEAD" ]; then
  git -C "$project_root" branch -D "$branch" >/dev/null 2>&1 || true
fi

echo "sapa teardown: removed worktree $target and branch $branch"

# Best-effort, last: closing the window kills the terminal running this script
# when invoked from inside it, which is exactly the intended terminal action.
if $close_enabled; then
  close_editor_window "$window_name"
fi
