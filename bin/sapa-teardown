#!/bin/bash
# sapa teardown — remove a finished stream's worktree and local branch.
#
# The terminal step of watch: once a PR is merged, the stream is done. This
# removes the worktree and deletes its local branch so there is no manual
# cleanup.
#
# Two guards:
#   * It refuses to tear down a worktree with uncommitted changes (exit 3).
#   * It runs `git` from the project root, never from inside the worktree it is
#     removing, so it works even when called from within that worktree. The
#     caller's shell cwd will be invalid afterwards — that is expected, the
#     window is closed for you.
#
# Closing the editor window: teardown closes nothing on its own. Set `closer:`
# in your personal `~/.sapa/settings.yaml` to a command and teardown runs it with
# the removed worktree's basename, so the window that was open on the stream goes
# with it. sapa ships one closer, `sapa close code`; see its help for what it
# drives, and write your own for any other editor:
#
#   closer: sapa close code
#
# Leave `closer:` unset and teardown touches no windows. The setting is personal
# rather than a project key on purpose: which editor you run is yours, not
# something a checked-in config should decide for the rest of the team.
#
# Project cleanup is separate. Set `teardown:` in the project's `.sapa.yaml` to
# a shell command and teardown runs it from the worktree before removing
# anything. A non-zero exit stops teardown so the worktree and branch remain
# available for diagnosis and another attempt:
#
#   teardown: mise dev:teardown
#
# `SAPA_TEARDOWN_CLOSER` overrides the setting with a command of the same shape
# (used by the tests, which must never drive a real editor).
#
# Usage:
#   sapa teardown [worktree-path]     # defaults to the current directory
#   sapa teardown -f|--force [path]   # remove even with uncommitted changes

set -euo pipefail

# Run the configured closer on the removed worktree's basename. Best-effort: it
# never fails the teardown, which has already done its work by the time this
# runs. A closer reports a status on stdout so the failures worth surfacing
# become an actionable line instead of silence. Status is one of: `closed`,
# `no-match` (zero or several windows matched), `no-editor` (nothing to close),
# `error:<n>` (any failure), or empty (the close killed the closer before it
# could report — that only happens on success, so treat it as done).
#
# Its stderr is left alone rather than swallowed: a closer explains its own
# trouble, and `sapa close code` has more to say about a denied close than the
# status word carries.
run_closer() {
  local closer="$1" name="$2" result=""
  # Unquoted on purpose, so `closer: sapa close code` splits into a command and
  # its arguments. `set -f` first so that is all it does: a `*` in the value
  # belongs to the closer, not to whatever sits in the current directory.
  set -f
  result="$($closer "$name")" || true
  set +f

  case "$result" in
    ""|closed|no-editor|no-match) : ;;  # done, or a benign no-op — stay quiet
    error:-25211|*"not allowed assistive access"*)
      printf '%s\n' "sapa teardown: couldn't close the window — grant Accessibility to the app running this terminal in System Settings > Privacy & Security > Accessibility, then it will close on the next teardown." >&2 ;;
    *)
      printf '%s\n' "sapa teardown: the closer reported $result; left the window open." >&2 ;;
  esac
}

force=false
target=""
while [ $# -gt 0 ]; do
  case "$1" in
    -f|--force) force=true ;;
    -h|--help) grep '^#' "$0" | grep -v '^#!' | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) echo "sapa teardown: unknown flag: $1" >&2; exit 2 ;;
    *) target="$1" ;;
  esac
  shift
done

target="${target:-${PWD:-$(pwd)}}"
target="$(cd "$target" && pwd)"   # normalise to an absolute path

# Find the project root: walk up from the target until we see a .bare directory.
project_root=""
dir="$target"
while [ -n "$dir" ] && [ "$dir" != "/" ]; do
  if [ -d "$dir/.bare" ]; then project_root="$dir"; break; fi
  dir=$(dirname "$dir")
done
if [ -z "$project_root" ]; then
  echo "sapa teardown: no .bare found above $target" >&2
  exit 1
fi

if [ "$target" = "$project_root" ]; then
  echo "sapa teardown: refusing to remove the project root itself" >&2
  exit 1
fi

branch="$(git -C "$target" rev-parse --abbrev-ref HEAD)"

# Which closer to run, if any. `SAPA_TEARDOWN_CLOSER` wins so the tests can stand
# one in; otherwise read `closer:` from the personal settings. Settings live at a
# fixed path in $HOME, not beside the worktree, so this could be read at any
# point — it sits here next to the basename it will be handed.
window_name="$(basename "$target")"
closer="${SAPA_TEARDOWN_CLOSER:-}"
if [ -z "$closer" ]; then
  # Resolve sapa-settings: prefer PATH, fall back to a sibling of this script, so
  # the closer is found even when teardown is invoked by an absolute path with an
  # empty PATH.
  sapa_settings="$(command -v sapa-settings || true)"
  if [ -z "$sapa_settings" ] && [ -x "$(dirname "$0")/sapa-settings" ]; then
    sapa_settings="$(dirname "$0")/sapa-settings"
  fi
  if [ -n "$sapa_settings" ]; then
    # A best-effort grep of the printed settings — no YAML parser — mirroring how
    # the skills read their keys. Quotes are stripped so `closer: "sapa close
    # code"` works too.
    closer="$("$sapa_settings" -p 2>/dev/null \
              | sed -nE 's/^[[:space:]]*closer:[[:space:]]*(.+)$/\1/p' \
              | head -1 \
              | sed -E 's/[[:space:]]+$//; s/^"(.*)"$/\1/; s/^'\''(.*)'\''$/\1/' || true)"
  fi
fi

# Guard: never destroy uncommitted work.
if ! $force && [ -n "$(git -C "$target" status --porcelain)" ]; then
  echo "sapa teardown: $target has uncommitted changes; not removing." >&2
  echo "Commit, stash, or rerun with -f/--force." >&2
  exit 3
fi

# Run the project's cleanup hook while its worktree and config still exist.
# Resolve sapa-config beside this script first so a branch-local teardown uses
# the matching branch-local config discovery behavior, then fall back to PATH.
teardown_command=""
sapa_config="$(dirname "$0")/sapa-config"
if [ ! -x "$sapa_config" ]; then
  sapa_config="$(command -v sapa-config || true)"
fi
if [ -n "$sapa_config" ]; then
  teardown_command="$("$sapa_config" -p --start "$target" 2>/dev/null \
                      | sed -nE 's/^teardown:[[:space:]]*(.+)$/\1/p' \
                      | head -1 \
                      | sed -E 's/[[:space:]]+$//; s/^"(.*)"$/\1/; s/^'\''(.*)'\''$/\1/' || true)"
fi

if [ -n "$teardown_command" ]; then
  if (cd "$target" && /bin/bash -c "$teardown_command"); then
    :
  else
    hook_rc=$?
    echo "sapa teardown: project teardown command failed (exit $hook_rc); not removing $target." >&2
    exit "$hook_rc"
  fi
fi

# Clear this stream's window-switcher status file while the worktree (and its
# `.bare` ancestor that `sapa status` walks up to) still exists, so the switcher
# stops showing a stream that is about to be gone. Best-effort — a missing helper
# or a failure here never blocks the teardown. Only the `sapa` dispatcher is on
# PATH, so call the helper by its sibling path, as the dispatcher itself does.
status_bin="$(dirname "$0")/sapa-status"
if [ -x "$status_bin" ]; then
  "$status_bin" --clear --start "$target" >/dev/null 2>&1 || true
fi

# Run git from the project root so the removal works even if the caller is
# sitting inside the worktree being removed.
if $force; then
  git -C "$project_root" worktree remove --force "$target"
else
  git -C "$project_root" worktree remove "$target"
fi

if [ -n "$branch" ] && [ "$branch" != "HEAD" ]; then
  git -C "$project_root" branch -D "$branch" >/dev/null 2>&1 || true
fi

echo "sapa teardown: removed worktree $target and branch $branch"

# Best-effort, last: closing the window kills the terminal running this script
# when invoked from inside it, which is exactly the intended terminal action.
if [ -n "$closer" ]; then
  run_closer "$closer" "$window_name"
fi
